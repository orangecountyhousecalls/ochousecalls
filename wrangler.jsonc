{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ochousecalls",
  // Matches the existing Worker. Workers Builds deploys previews with `npx wrangler preview`, which requires this block.
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "previews": {}
}
